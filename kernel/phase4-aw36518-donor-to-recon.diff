+
+static __always_inline int aw36518_gpio_init(struct aw36518_flash *flash)
+{
+	struct device_node *np = flash->dev->of_node;
+	int gpio, rval;
+
+	gpio = of_get_named_gpio(np, "flash-externel", 0);
+	if (gpio > 0) {
+		if (!gpio_is_valid(gpio)) {
+			aw_log("Invalid chip select pin\n");
+			return -1;
+		}
+		rval = devm_gpio_request_one(flash->dev, gpio, GPIOF_OUT_INIT_LOW,
+					    "flash_externel");
+		if (rval) {
+			aw_log("GPIO(%d) request failed(%d)\n", gpio, rval);
+			return rval;
+		}
+		flash->flash_externel_gpio = gpio;
+	}
+	aw_log("wl2864c_i2c_probe vin1_enable_gpio:%d...\n",
+		flash->flash_externel_gpio);
+	return 0;
+}
