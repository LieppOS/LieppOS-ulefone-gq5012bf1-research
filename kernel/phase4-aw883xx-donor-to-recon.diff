+/* v1.7.1 sysst gate masks.
+ * stock aw883xx_pid_2183_dev_init writes:
+ *   noise_gate_en.gate[0] = { 0x16, 0xffffdfff, 0xfffffeff }
+ *   noise_gate_en.gate[1] = { 0x69, 0xfffffffb, 0xfffffdff }
+ * 0xfffffeff == ~SWS_SWITCHING_VALUE (bit 8), 0xfffffdff == ~BSTS_FINISHED_VALUE
+ * (bit 9).  Bit 2 of BSTCTRL10 (0x69) has no name in the published Awinic
+ * headers, so it is carried by address until its semantics are demonstrated.
+ */
+#define AW_PID_2183_SWS_SWITCHING_MASK	\
+	(~(((1<<AW_PID_2183_SWS_BITS_LEN)-1) << AW_PID_2183_SWS_START_BIT))
+
+#define AW_PID_2183_BSTS_FINISHED_MASK	\
+	(~(((1<<AW_PID_2183_BSTS_BITS_LEN)-1) << AW_PID_2183_BSTS_START_BIT))
+
+#define AW_PID_2183_REG_0X69_BIT2_START_BIT	(2)
+#define AW_PID_2183_REG_0X69_BIT2_BITS_LEN	(1)
+#define AW_PID_2183_REG_0X69_BIT2_MASK	\
+	(~(((1<<AW_PID_2183_REG_0X69_BIT2_BITS_LEN)-1) << AW_PID_2183_REG_0X69_BIT2_START_BIT))
+
 #define AW_PID_2183_BIT_SYSST_SWS_CHECK \
 		(AW_PID_2183_BSTS_FINISHED_VALUE | \
 		AW_PID_2183_CLKS_STABLE_VALUE | \
diff -Nru --strip-trailing-cr donor-pristine/BUILD.bazel recon/BUILD.bazel
--- donor-pristine/BUILD.bazel	1970-01-01 03:00:00.000000000 +0300
+++ recon/BUILD.bazel	2026-09-07 02:53:02.715622137 +0300
@@ -0,0 +1,17 @@
+load("//build/kernel/kleaf:kernel.bzl", "kernel_module")
+
+package(default_visibility = ["//visibility:public"])
+
+# LieppOS reconstruction of the GQ5012BF1 stock aw883xx_driver.ko,
+# built against the exact Google GKI 12901745 kernel (//common:kernel_aarch64).
+#
+# The module has no providers outside vmlinux: all 74 stock __versions entries
+# resolve against GKI 12901745 with identical CRCs (see
+# aw883xx-provider-boundary.tsv).  Its only consumer is mtk-sp-spk-amp.ko.
+kernel_module(
+    name = "aw883xx_driver_gki",
+    srcs = glob(["*.c", "*.h"]) + ["Makefile"],
+    outs = ["aw883xx_driver.ko"],
+    kernel_build = "//common:kernel_aarch64",
+    visibility = ["//visibility:public"],
+)
diff -Nru --strip-trailing-cr donor-pristine/Makefile recon/Makefile
--- donor-pristine/Makefile	1970-01-01 03:00:00.000000000 +0300
+++ recon/Makefile	2026-09-07 02:53:02.714622137 +0300
@@ -0,0 +1,39 @@
+# LieppOS reconstruction of the Ulefone GQ5012BF1 stock aw883xx_driver.ko (v1.7.1).
+#
+# Object order reproduces the stock link order, which was recovered from the
+# stock .text layout (first function of each translation unit):
+#   0x000004 aw883xx_monitor.c        (aw883xx_monitor_start)
+#   0x001b14 aw883xx_bin_parse.c      (aw883xx_dev_dsp_data_order)
+#   0x003a94 aw883xx_device.c         (aw883xx_dev_get_list_head)
+#   0x008694 aw883xx_init.c           (aw883xx_init_check_chipid)
+#   0x0089a0 aw883xx_calib.c          (aw883xx_cali_check_result)
+#   0x00e974 aw883xx_spin.c           (aw883xx_spin_check_mode)
+#   0x00f7e0 aw883xx.c                (aw883xx_get_version)
+#   0x015844 aw883xx_pid_2049_init.c  (aw883xx_pid_2049_dev_init)
+#   0x017078 aw883xx_pid_2066_init.c  (aw883xx_pid_2066_dev_init)
+#   0x017bac aw883xx_pid_2183_init.c  (aw883xx_pid_2183_dev_init)
+ifneq ($(KERNELRELEASE),)
+
+obj-m += aw883xx_driver.o
+aw883xx_driver-y := aw883xx_monitor.o \
+		aw883xx_bin_parse.o \
+		aw883xx_device.o \
+		aw883xx_init.o \
+		aw883xx_calib.o \
+		aw883xx_spin.o \
+		aw883xx.o \
+		aw883xx_pid_2049_init.o \
+		aw883xx_pid_2066_init.o \
+		aw883xx_pid_2183_init.o
+
+else
+
+.PHONY: all modules modules_install clean
+all modules:
+	$(MAKE) -C $(KERNEL_SRC) M=$(M) KBUILD_MODPOST_WARN=1 modules
+modules_install:
+	$(MAKE) -C $(KERNEL_SRC) M=$(M) modules_install
+clean:
+	$(MAKE) -C $(KERNEL_SRC) M=$(M) clean
+
+endif
