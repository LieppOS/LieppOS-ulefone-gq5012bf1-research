-	unsigned int st_sws_check;
+	/* v1.7.1: st_sws_check was removed; st_check now carries the *_SWS_CHECK
+	 * value directly and aw_dev_sysst_check() masks bits out of it through
+	 * struct aw_sysst_gate (see aw_noise_gate_en below).
+	 * Evidence: stock sizeof(struct aw_device)=0x750 vs donor 0x748,
+	 * offsetof(profctrl_desc)=0xe8 vs 0xec, and stock
+	 * aw883xx_pid_2066/2183_dev_init store 0x311 (=*_BIT_SYSST_SWS_CHECK)
+	 * into sysst_desc.st_check while writing no field at sysst_desc+0x18.
+	 */
 };
 
-struct aw_noise_gate_en {
+/* v1.7.1 sysst gate entry.
+ * When (reg != AW_REG_NONE) and (reg_val & ~mask) is non-zero, aw_dev_sysst_check()
+ * ANDs st_and_mask into the expected SYSST check value.  Recovered from the stock
+ * aw883xx_device_start disassembly (inlined aw_dev_sysst_check):
+ *   ldr w1,[aw_dev+0x318] ; cmp #0xff ; reg_read ; ldr w9,[+0x31c] ; bics ;
+ *   ldr w8,[+0x320] ; and check_value,w8,check_value
+ *   ldr w1,[aw_dev+0x324] ; cmp #0xff ; reg_read ; ldr w9,[+0x328] ; bics ;
+ *   ldr w8,[+0x32c] ; and check_value,w8,check_value
+ */
+struct aw_sysst_gate {
 	unsigned int reg;
 	unsigned int noise_gate_mask;
+	unsigned int st_and_mask;
+};
+
+#define AW_SYSST_GATE_NUM	(2)
+
+struct aw_noise_gate_en {
+	struct aw_sysst_gate gate[AW_SYSST_GATE_NUM];
 };
 
