# Local kernel research runtime artifacts
__pycache__/
*.pyc
*.log
/kernel/*.log
/kernel/scripts/__pycache__/

# Reproducible generated Phase 2 intermediates
/kernel/nothing-module-index.csv

# Unpacked vendor/system extractions and working reconstructions: everything here is
# re-derived from the hash-pinned stock images, so it is never committed.
workspace/

# --- upstream reference clones -------------------------------------------------
# Full upstream/SDK checkouts kept locally to compare stock code against. They own
# their own history and licence, so they are never vendored into this repo.
/hardware/nfc/aosp-reference/
/hardware/nfc/esp32code/
/qwen_hardware/qwen-thermal/re/apps/donors/

# --- regenerable extractions --------------------------------------------------
# Decompiled APK trees and per-binary symbol/string dumps: re-run the tool in
# qwen_hardware/*/tools/ (or re-find the library) to regenerate them byte-identically.
/qwen_hardware/qwen-thermal/re/apps/infisens/
/qwen_hardware/qwen-thermal/re/apps/infdlp/
/qwen_hardware/qwen-thermal/re/apps/factorymode/
/qwen_hardware/qwen-thermal/evidence/apk/
/qwen_hardware/qwen-thermal/evidence/local/dt/
/qwen_hardware/qwen-thermal/evidence/binaries/strings/
/qwen_hardware/qwen-thermal/evidence/binaries/symbols/
/hardware/nfc/blobs/

# ST21 re-audits: the per-topic reports and their cited evidence excerpts are
# findings, the jadx trees and copied runtime blobs beside them are not. Keep the
# reports, drop the ~93 MB of decompiled sources and binaries around them.
/hardware/nfc/analysis/*
!/hardware/nfc/analysis/st21-gemini-audit/
/hardware/nfc/analysis/st21-gemini-audit/*
!/hardware/nfc/analysis/st21-gemini-audit/*.md
!/hardware/nfc/analysis/st21-gemini-audit/evidence/
# ... and the *derived* loader evidence (10 files, ~250 KB: tool output plus
# per-function listings, no raw disassembly) is kept too: firmware-loader-rev2.md
# cites those paths, and "re-run the tool to check me" is only reviewable if the
# reference output is in history. The ~15 MB of raw objdump it regenerates them
# from stays ignored (hardware/nfc/.gitignore).
!/hardware/nfc/analysis/st21-gemini-audit/audit/
!/hardware/nfc/analysis/st21-mifare-ce-qwen-bad-report/
/hardware/nfc/analysis/st21-mifare-ce-qwen-bad-report/*
!/hardware/nfc/analysis/st21-mifare-ce-qwen-bad-report/*.md

