+static void aw_monitor_get_hw_monitor_st(struct aw_monitor_desc *monitor_desc)
+{
+	int ret = -1;
+	uint16_t reg_data = 0;
+	struct aw_device *aw_dev = container_of(monitor_desc,
+			struct aw_device, monitor_desc);
+	struct aw_hw_monitor_desc *hw_monitor_desc = &monitor_desc->hw_monitor_desc;
+
+	if (hw_monitor_desc->reg == AW_REG_NONE)
+		return;
+
+	ret = aw_dev->ops.aw_reg_read(aw_dev, hw_monitor_desc->reg, &reg_data);
+	if (ret < 0) {
+		aw_dev_err(aw_dev->dev, "read 0x%02x failed", hw_monitor_desc->reg);
+		return;
+	}
+
+	if ((reg_data & (~hw_monitor_desc->bop_mask)) &&
+			((reg_data & (~hw_monitor_desc->vol_mask)) ||
+			(reg_data & (~hw_monitor_desc->ipeak_mask))))
+		monitor_desc->hw_monitor_en = AW_MONITOR_ENABLE;
+	else
+		monitor_desc->hw_monitor_en = AW_MONITOR_DISABLE;
+}
+
+static void aw_monitor_get_dsp_monitor_st(struct aw_monitor_desc *monitor_desc)
+{
+	int ret = -1;
+	uint32_t temp_reg_value = 0;
+	uint32_t volt_reg_value = 0;
+	uint32_t dsp_volt_en = 0;
+	uint32_t dsp_temp_en = 0;
+	uint32_t extern_temp_en = 0;
+	struct aw_device *aw_dev = container_of(monitor_desc,
+			struct aw_device, monitor_desc);
+	struct aw_dsp_monitor_desc *dsp_monitor_desc = &monitor_desc->dsp_monitor_desc;
+
+	if ((dsp_monitor_desc->dsp_temp_reg == AW_REG_NONE) ||
+		(dsp_monitor_desc->dsp_volt_reg == AW_REG_NONE))
+		return;
+
+	ret = aw_dev->ops.aw_dsp_read(aw_dev, dsp_monitor_desc->dsp_temp_reg,
+			&temp_reg_value, dsp_monitor_desc->dsp_temp_reg_type);
+	if (ret < 0) {
+		aw_dev_err(aw_dev->dev, "read 0x%04x failed", dsp_monitor_desc->dsp_temp_reg);
+		return;
+	}
+
+	ret = aw_dev->ops.aw_dsp_read(aw_dev, dsp_monitor_desc->dsp_volt_reg,
+			&volt_reg_value, dsp_monitor_desc->dsp_volt_reg_type);
+	if (ret < 0) {
+		aw_dev_err(aw_dev->dev, "read 0x%04x failed", dsp_monitor_desc->dsp_temp_reg);
+		return;
+	}
+
+	dsp_temp_en = temp_reg_value & (~dsp_monitor_desc->dsp_temp_en_mask);
+	extern_temp_en = temp_reg_value & (~dsp_monitor_desc->extn_temp_en_mask);
+	dsp_volt_en = volt_reg_value & (~dsp_monitor_desc->dsp_volt_en_mask);
+
+	if (extern_temp_en)
+		monitor_desc->dsp_temp_flag = AW_EXTERNAL_TEMP;
+	else
+		monitor_desc->dsp_temp_flag = AW_INTERNAL_TEMP;
+
+	if (dsp_temp_en || dsp_volt_en)
+		monitor_desc->dsp_monitor_en = AW_MONITOR_ENABLE;
+	else
+		monitor_desc->dsp_monitor_en = AW_MONITOR_DISABLE;
+
+}
+
+static void aw_monitor_set_init_vmax(struct aw_monitor_desc *monitor_desc)
+{
+	int ret = -1;
+	struct aw_vmax_desc *desc = &monitor_desc->vmax_desc;
+	struct aw_device *aw_dev = container_of(monitor_desc,
+			struct aw_device, monitor_desc);
+
+	ret = aw_dev->ops.aw_dsp_write(aw_dev, desc->dsp_reg, desc->init_vmax, desc->data_type);
+	if (ret < 0) {
+		aw_dev_err(aw_dev->dev, "set vmax failed");
+		return;
+	}
+}
+
+static void aw_monitor_get_init_vmax(struct aw_monitor_desc *monitor_desc)
+{
+	int ret = -1;
+	unsigned int vmax = 0;
+	struct aw_vmax_desc *desc = &monitor_desc->vmax_desc;
+	struct aw_device *aw_dev = container_of(monitor_desc,
+			struct aw_device, monitor_desc);
+
+	ret = aw_dev->ops.aw_dsp_read(aw_dev, desc->dsp_reg, &vmax, desc->data_type);
+	if (ret < 0) {
+		aw_dev_err(aw_dev->dev, "get vmax failed");
+		return;
+	}
+
+	desc->init_vmax = vmax;
+	aw_dev_info(aw_dev->dev, "get init vmax:0x%x",
+			desc->init_vmax);
+}
+
+void aw883xx_monitor_update_st(struct aw_monitor_desc *monitor_desc, monitor_update_t type)
+{
+	struct aw_device *aw_dev = container_of(monitor_desc,
+			struct aw_device, monitor_desc);
+
+	switch (type) {
+	case AW_GET_INIT_VMAX:
+		aw_monitor_get_init_vmax(monitor_desc);
+		break;
+	case AW_SET_INIT_VMAX:
+		aw_monitor_set_init_vmax(monitor_desc);
+		break;
+	case AW_DSP_MONITOR_ST:
+		aw_monitor_get_dsp_monitor_st(monitor_desc);
+		break;
+	case AW_HW_MONITOR_ST:
+		aw_monitor_get_hw_monitor_st(monitor_desc);
+		break;
+	default:
+		aw_dev_err(aw_dev->dev, "unsupported type:%d", type);
+		return;
+	}
+}
