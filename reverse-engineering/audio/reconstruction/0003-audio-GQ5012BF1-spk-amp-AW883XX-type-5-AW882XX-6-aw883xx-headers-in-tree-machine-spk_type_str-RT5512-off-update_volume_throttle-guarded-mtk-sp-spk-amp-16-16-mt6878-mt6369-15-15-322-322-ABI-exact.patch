+
+	aw_dev_info(aw883xx->dev,
+			"read chip id: 0x%x", reg_val);
+
+	ret = aw883xx_init_check_chipid(aw883xx, reg_val);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
