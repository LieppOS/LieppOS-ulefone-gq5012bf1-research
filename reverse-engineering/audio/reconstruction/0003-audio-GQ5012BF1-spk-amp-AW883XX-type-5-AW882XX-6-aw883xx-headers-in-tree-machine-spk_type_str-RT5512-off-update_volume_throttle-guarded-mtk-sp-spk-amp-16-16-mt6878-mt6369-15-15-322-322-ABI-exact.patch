+			(void *)&mute_status, sizeof(mute_status), AW_GET_DEV_PARAMS);
+	if ((ret < 0) || (mute_status == AW_DEV_HMUTE_ENABLE)) {
+		aw_dev_err(aw_dev->dev, "get mute status:%d, ret=%d", mute_status, ret);
+		return -EINVAL;
+	}
+
+	return 0;
