+
+	*re = AW_DSP_RE_TO_SHOW_RE(*re, desc->shift);
+	*re -= aw_dev->cali_desc.ra;
+
+	aw_dev_info(aw_dev->dev, "get dsp re:%d", *re);
+
+	return 0;
+}
