+static int aw883xx_match_chipid(struct aw883xx *aw883xx)
+{
+	int ret = -1;
+	uint16_t reg_val = 0;
+
+	ret = aw883xx_reg_read(aw883xx, AW883XX_CHIP_ID_REG, &reg_val);
+	if (ret < 0) {
+		aw_dev_err(aw883xx->dev,
+			"failed to read chip id, ret=%d", ret);
+		return -EIO;
