+static int aw_cali_svc_cali_init_check(struct aw_device *aw_dev)
+{
+	int ret = -1;
+	bool status = false;
+	uint32_t mute_status = AW_DEV_HMUTE_ENABLE;
+
+	aw_dev_dbg(aw_dev->dev, "enter");
+
+	/* get pa status */
