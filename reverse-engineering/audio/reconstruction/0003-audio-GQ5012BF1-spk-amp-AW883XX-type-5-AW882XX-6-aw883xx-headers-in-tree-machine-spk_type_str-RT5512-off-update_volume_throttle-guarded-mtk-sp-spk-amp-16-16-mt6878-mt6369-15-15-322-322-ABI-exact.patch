+static void aw_cali_disable_dsp_ng(struct aw_device *aw_dev, bool status)
+{
+	struct aw_dsp_ng_desc *dsp_ng_desc = &aw_dev->dsp_ng_desc;
+
+	if (status) {
+		aw883xx_device_params(aw_dev, AW_DEV_DSP_NOISE_GATE_PARAMS,
+			(void *)&dsp_ng_desc->disable, sizeof(unsigned int),
+			AW_SET_DEV_PARAMS);
+		aw883xx_device_params(aw_dev, AW_DEV_DSP_LOW_POWER_PARAMS,
+			(void *)&dsp_ng_desc->dsp_lp_disable, sizeof(unsigned int),
+			AW_SET_DEV_PARAMS);
+	} else {
+		aw883xx_device_params(aw_dev, AW_DEV_DSP_NOISE_GATE_PARAMS,
+			(void *)&dsp_ng_desc->enable, sizeof(unsigned int),
+			AW_SET_DEV_PARAMS);
+		aw883xx_device_params(aw_dev, AW_DEV_DSP_LOW_POWER_PARAMS,
+			(void *)&dsp_ng_desc->dsp_lp_enable, sizeof(unsigned int),
+			AW_SET_DEV_PARAMS);
+	}
+}
