+/*
+ * v1.7.1 replaces aw_dev_parse_dev_type_v_1_0_0_0() and
+ * aw_dev_parse_default_type_v_1_0_0_0() with a single scene parser.
+ *
+ * Recovered from the stock aw883xx_dev_cfg_load disassembly (the function is
+ * static and fully inlined; its __func__ string "aw_dev_parse_scene_v_1_0_0_0"
+ * and its "no valid device scenario resolved" error string are present in
+ * .rodata.str1.1 while "get dev type failed, get num [%d]" is not referenced):
+ *
+ *   pass 1: walk cfg_hdr->a_ddt_num DDEs.
+ *           dev_type   -> require i2c adapter nr == dev_bus (dde+0x16)
+ *                                 i2c addr      == dev_addr (dde+0x18)
+ *           default    -> require aw_dev->channel == dev_index (dde+0x14)
+ *           both       -> require aw_dev->chip_id == chip_id   (dde+0x4c)
+ *           matching indexes are insertion-sorted ascending by
+ *           dev_profile (dde+0x1a) into a 32-entry index table
+ *           (stack array, bound checked against 0x1f).
+ *   pass 2: for each sorted index, dispatch on data_type:
+ *           ACF_SEC_TYPE_MONITOR  -> aw883xx_monitor_parse_fw(&aw_dev->monitor_desc, ...)
+ *           ACF_SEC_TYPE_MUTLBIN  -> aw_dev_prof_parse_multi_bin(... &prof_desc[cur])
+ *                                    prof_desc[cur].prf_str = dde->dev_profile_str
+ *                                    prof_desc[cur].id      = dde->dev_profile
+ *                                    cur++
+ *           default               -> "unsupported SEC_TYPE [%d]"
+ *   cur == 0 -> "no valid device scenario resolved", -EINVAL
+ *
+ * The ascending dev_profile sort is new in v1.7.1: v1.6.0 filled prof_desc[] in
+ * DDE file order.
+ */
+#define AW_SCENE_INDEX_MAX	(32)
+
+static int aw_dev_parse_scene_v_1_0_0_0(struct aw_device *aw_dev,
+		struct aw_cfg_hdr *prof_hdr, bool dev_type)
+{
+	int i, j, k;
+	int ret;
+	int cur_scene_id = 0;
+	int num = 0;
+	int index[AW_SCENE_INDEX_MAX];
+	struct aw_cfg_dde_v_1_0_0_0 *cfg_dde =
+		(struct aw_cfg_dde_v_1_0_0_0 *)((char *)prof_hdr + prof_hdr->a_hdr_offset);
+
+	aw_dev_info(aw_dev->dev, "enter");
+
+	for (i = 0; i < prof_hdr->a_ddt_num; i++) {
+		if (dev_type) {
+			if (aw_dev->i2c->adapter->nr != cfg_dde[i].dev_bus)
+				continue;
+			if (aw_dev->i2c->addr != cfg_dde[i].dev_addr)
+				continue;
+		} else {
+			if (aw_dev->channel != cfg_dde[i].dev_index)
+				continue;
+		}
+
+		if (aw_dev->chip_id != cfg_dde[i].chip_id)
+			continue;
+
+		/* LieppOS hardening: stock relies on the compiler's array-bounds
+		 * trap here; an explicit bound cannot change behaviour for any
+		 * ACF with <= 32 matching DDEs (see RED.md deviation D10).
+		 */
+		if (num >= AW_SCENE_INDEX_MAX)
+			return -EINVAL;
+
+		/* keep index[] ordered by ascending dev_profile */
+		for (j = 0; j < num; j++)
+			if (cfg_dde[i].dev_profile < cfg_dde[index[j]].dev_profile)
+				break;
+		for (k = num; k > j; k--)
+			index[k] = index[k - 1];
+		index[j] = i;
+		num++;
+	}
+
+	for (k = 0; k < num; k++) {
+		ret = aw_dev_parse_data_by_sec_type_v_1_0_0_0(aw_dev, prof_hdr,
+						&cfg_dde[index[k]], &cur_scene_id);
+		if (ret < 0) {
+			aw_dev_err(aw_dev->dev, "parse failed");
+			return ret;
+		}
+	}
+
+	if (cur_scene_id == 0) {
+		aw_dev_err(aw_dev->dev, "no valid device scenario resolved");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int aw_dev_parse_by_hdr_v_1_0_0_0(struct aw_device *aw_dev,
+		struct aw_cfg_hdr *cfg_hdr)
+{
+	int ret;
+
+	/* Stock v1.7.1 resolves the DDE selector into a single bool and has one
+	 * aw_dev_parse_scene_v_1_0_0_0 call site (the stock disassembly branches
+	 * to a common body with w21 = (prof_type == AW_DEV_TYPE_ID)).
+	 */
+	if ((aw_dev->prof_info.prof_type != AW_DEV_TYPE_ID) &&
+		(aw_dev->prof_info.prof_type != AW_DEV_DEFAULT_TYPE_ID)) {
+		aw_dev_err(aw_dev->dev, "prof type matched failed, get num[%d]",
+			aw_dev->prof_info.prof_type);
+		return -EINVAL;
+	}
+
+	ret = aw_dev_parse_scene_v_1_0_0_0(aw_dev, cfg_hdr,
+			aw_dev->prof_info.prof_type == AW_DEV_TYPE_ID);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
