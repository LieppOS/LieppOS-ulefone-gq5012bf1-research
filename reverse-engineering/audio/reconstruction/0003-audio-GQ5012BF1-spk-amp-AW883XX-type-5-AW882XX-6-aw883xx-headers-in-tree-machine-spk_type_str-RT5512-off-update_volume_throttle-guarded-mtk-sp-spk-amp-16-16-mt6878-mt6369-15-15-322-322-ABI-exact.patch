+/* LieppOS reconstruction (stock GQ5012BF1 aw883xx_driver.ko v1.7.1):
+ * AW_CALI_STORE_EXAMPLE is NOT enabled in the stock module.
+ * Evidence: the stock .ko imports neither filp_open/filp_close/kernel_read/
+ * kernel_write nor skip_spaces, contains no "/mnt/vendor/persist/factory/audio/
+ * aw_cali.bin" string, and has no aw_cali_write_re_to_nvram symbol.
+ * Calibration Re is therefore volatile in-kernel only; persistence is owned by
+ * userspace/HAL (see firmware-config-contract.md).
+ */
+/*#define AW_CALI_STORE_EXAMPLE*/
+#include "aw883xx_data_type.h"
+
+/*
+ * LieppOS safety gates.  Both default to 1, i.e. exactly the stock behaviour;
+ * with the defaults the generated code is byte-identical to the stock module.
+ * Set to 0 only for bring-up on hardware whose speaker/boost state is unknown.
+ *
+ *   AW_ALLOW_CALIBRATION_WRITES  0 -> refuse to *run* Re/F0 calibration and to
+ *                                     push a new Re into the DSP.  Reads of
+ *                                     Re/R0/F0/Q/Te stay available.
+ *   AW_ALLOW_FACTORY_MODE        0 -> make the raw register / DSP debug sysfs
+ *                                     windows (reg, rw, dsp, dsp_rw, awrw)
+ *                                     read-only.
+ * Ordinary playback initialisation, profile/firmware download, power sequencing
+ * and monitor protection are never gated: the stock evidence proves they are
+ * required for normal operation.
+ */
+#ifndef AW_ALLOW_CALIBRATION_WRITES
+#define AW_ALLOW_CALIBRATION_WRITES	(1)
+#endif
+#ifndef AW_ALLOW_FACTORY_MODE
+#define AW_ALLOW_FACTORY_MODE		(1)
+#endif
+
+#define AW_ERRO_CALI_RE_VALUE (0)
+#define AW_ERRO_CALI_F0_VALUE (2600)
+
+#define AW_CALI_RE_DEFAULT_TIMER (1000)	/* stock v1.7.1: g_cali_re_time initialiser at .data+0x1e8 is 0x3e8, not 0xbb8 */
+#define MSGS_SIZE (512)
+#define RESERVED_SIZE (252)
+
+#define AW_CALI_ALL_DEV (0xFFFFFFFF)
+
+#define AW_CALI_RE_MAX (15000)
