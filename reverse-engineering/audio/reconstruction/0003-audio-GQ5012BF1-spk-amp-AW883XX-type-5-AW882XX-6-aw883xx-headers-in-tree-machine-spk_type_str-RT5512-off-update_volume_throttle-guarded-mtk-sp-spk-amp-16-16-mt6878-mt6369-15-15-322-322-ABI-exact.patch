+/******************************************************
+ *
+ * sys group attribute: reg
+ *
+ ******************************************************/
+static ssize_t reg_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct aw883xx *aw883xx = dev_get_drvdata(dev);
+	struct aw_device *aw_dev = aw883xx->aw_pa;
+	int reg_num = aw_dev->ops.aw_get_reg_num();
+	ssize_t len = 0;
+	int i = 0;
+	uint16_t reg_val = 0;
+
+	for (i = 0; i < reg_num; i++) {
+		if (aw_dev->ops.aw_check_rd_access(i)) {
+			aw_dev->ops.aw_reg_read(aw_dev, i, &reg_val);
+			len += snprintf(buf + len, PAGE_SIZE - len,
+					"reg:0x%02x=0x%04x\n", i, reg_val);
+		}
+	}
+
+	return len;
+}
+
+static ssize_t reg_store(struct device *dev,
+				struct device_attribute *attr, const char *buf,
+				size_t count)
+{
+#if !AW_ALLOW_FACTORY_MODE
+	return -EPERM;
+#endif
+	struct aw883xx *aw883xx = dev_get_drvdata(dev);
+	struct aw_device *aw_dev = aw883xx->aw_pa;
+	unsigned int databuf[2] = { 0 };
+
+	if (sscanf(buf, "%x %x", &databuf[0], &databuf[1]) == 2)
+		aw_dev->ops.aw_reg_write(aw_dev, databuf[0], databuf[1]);
+
+	return count;
+}
+
+static ssize_t rw_store(struct device *dev,
+				struct device_attribute *attr, const char *buf,
+				size_t count)
+{
+#if !AW_ALLOW_FACTORY_MODE
+	return -EPERM;
+#endif
+	struct aw883xx *aw883xx = dev_get_drvdata(dev);
+	struct aw_device *aw_dev = aw883xx->aw_pa;
+	unsigned int databuf[2] = { 0 };
+
+	if (sscanf(buf, "%x %x", &databuf[0], &databuf[1]) == 2) {
+		aw883xx->reg_addr = (uint8_t)databuf[0];
+		if (aw_dev->ops.aw_check_rd_access(databuf[0]))
+			aw_dev->ops.aw_reg_write(aw_dev, databuf[0], databuf[1]);
+	} else if (kstrtouint(buf, 16, &databuf[0]) == 0) {
+		aw883xx->reg_addr = (uint8_t)databuf[0];
+	}
+
+	return count;
+}
