@@ -393,6 +414,21 @@ static inline int eeprom_driver_register(struct i2c_client *client,
 
 	mutex_init(&pinst->eeprom_mutex);
 
+	if (!camera_otp_class) {
+		int i;
+
+		camera_otp_class = class_create(THIS_MODULE, "camera_otp");
+		if (IS_ERR(camera_otp_class))
+			pr_err("create class, ret = %d\n",
+				(int)PTR_ERR(camera_otp_class));
+		for (i = 0; class_attr_camera_otp[i].attr.name; i++) {
+			ret = class_create_file(camera_otp_class,
+				&class_attr_camera_otp[i]);
+			if (ret)
+				pr_err("Fail class_create_file,ret=%d\n", ret);
+		}
+	}
+
 	return ret;
 }
 
@@ -408,6 +444,7 @@ static inline int eeprom_driver_unregister(struct i2c_client *client)
 
 	device_destroy(pinst->pclass, pinst->dev_no);
 	class_destroy(pinst->pclass);
+	class_destroy(camera_otp_class);
 
 	return 0;
 }
