+		(struct STRUCT_CAM_CAL_DATA_STRUCT *)pGetSensorCalData;
+	unsigned int err = CamCalReturnErr[pCamCalData->Command];
+	int read_data_size;
+
+	if (pCamCalData->DataVer >= CAM_CAL_TYPE_NUM) {
+		show_cmd_error_log(pCamCalData->Command);
