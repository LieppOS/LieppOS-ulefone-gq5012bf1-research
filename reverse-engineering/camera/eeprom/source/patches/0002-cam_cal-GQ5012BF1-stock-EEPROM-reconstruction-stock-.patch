+		pCamCalData->SingleLsc.LscTable.MtkLcsData.PixId != 8 &&
+		pCamCalData->SingleLsc.LscTable.MtkLcsData.MtkLscType != 0x4c &&
+		pCamCalData->SingleLsc.LscTable.MtkLcsData.MtkLscType != 7)
