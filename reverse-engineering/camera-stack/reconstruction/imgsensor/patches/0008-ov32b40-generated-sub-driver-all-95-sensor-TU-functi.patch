+// SPDX-License-Identifier: GPL-2.0
+// Copyright (c) 2022 MediaTek Inc.
+
+/*****************************************************************************
+ *
+ * Filename:
+ * ---------
+ *	 ov32b40mipiraw_Sensor.c
+ *
+ * Project:
+ * --------
+ *	 ALPS
+ *
+ * Description:
+ * ------------
+ *	 Source code of Sensor driver
+ *
+ *
+ *------------------------------------------------------------------------------
+ * Upper this line, this part is controlled by CC/CQ. DO NOT MODIFY!!
+ *============================================================================
+ ****************************************************************************/
+#include "ov32b40mipiraw_Sensor.h"
+
+static int init_ctx(struct subdrv_ctx *ctx,	struct i2c_client *i2c_client, u8 i2c_write_id);
+static int ov32b40_set_ctrl_locker(struct subdrv_ctx *ctx, u32 cid, bool *is_lock);
+static u16 get_gain2reg(u32 gain);
+static void set_group_hold(void *arg, u8 en);
+static int ov32b40_set_test_pattern(struct subdrv_ctx *ctx, u8 *para, u32 *len);
+
+/* STOCK-PARITY data: regenerated byte-exact from the GQ5012BF1 stock module */
+#include "ov32b40_stock_data.h"
+
+/* FUNCTION */
+
+static int init_ctx(struct subdrv_ctx *ctx,	struct i2c_client *i2c_client, u8 i2c_write_id)
+{
+	memcpy(&(ctx->s_ctx), &static_ctx, sizeof(struct subdrv_static_ctx));
+	subdrv_ctx_init(ctx);
+	ctx->i2c_client = i2c_client;
+	ctx->i2c_write_id = i2c_write_id;
+	return 0;
+}
+
+static int ov32b40_set_ctrl_locker(struct subdrv_ctx *ctx,
+		u32 cid, bool *is_lock)
+{
+	bool lock_set_ctrl = false;
+
+	if (unlikely(is_lock == NULL)) {
+		pr_info("[%s][ERROR] is_lock %p is NULL\n", __func__, is_lock);
+		return -EINVAL;
+	}
+
+	switch (cid) {
+	case V4L2_CID_MTK_STAGGER_AE_CTRL:
+	case V4L2_CID_MTK_MAX_FPS:
+		if ((ctx->sof_no == 0) && (ctx->is_streaming)) {
+			lock_set_ctrl = true;
+			DRV_LOG(ctx,
+				"[%s] Target lock cid(%u) lock_set_ctrl(%d), sof_no(%d) is_streaming(%d)\n",
+				__func__,
+				cid,
+				lock_set_ctrl,
+				ctx->sof_no,
+				ctx->is_streaming);
+		}
+		break;
+	default:
+		break;
+	}
+
+	*is_lock = lock_set_ctrl;
+	return ERROR_NONE;
+} /* ov32b40_set_ctrl_locker */
+
+static u16 get_gain2reg(u32 gain)
+{
+	return gain * 32 / BASEGAIN;
+}
+
+static void set_group_hold(void *arg, u8 en)
+{
+	struct subdrv_ctx *ctx = (struct subdrv_ctx *)arg;
+
+	if (en) {
+		set_i2c_buffer(ctx, 0x3208, 0x00);
+	} else {
+		set_i2c_buffer(ctx, 0x3208, 0x10);
+		set_i2c_buffer(ctx, 0x3208, 0xA0);
+	}
+}
+
+static int ov32b40_set_test_pattern(struct subdrv_ctx *ctx, u8 *para, u32 *len)
+{
+	u32 mode = *((u32 *)para);
+
+	if (mode != ctx->test_pattern)
+		DRV_LOG(ctx, "mode(%u->%u)\n", ctx->test_pattern, mode);
+	/* 1:Solid Color 2:Color Bar 5:Black */
+	if (mode) {
+		set_i2c_buffer(ctx, 0x50c1, 0x01);
+		set_i2c_buffer(ctx, 0x53c1, 0x01);
+	} else if (ctx->test_pattern) {
+		set_i2c_buffer(ctx, 0x50c1, 0x00);
+		set_i2c_buffer(ctx, 0x53c1, 0x00);
+	}
+
+	ctx->test_pattern = mode;
+	return ERROR_NONE;
+}
