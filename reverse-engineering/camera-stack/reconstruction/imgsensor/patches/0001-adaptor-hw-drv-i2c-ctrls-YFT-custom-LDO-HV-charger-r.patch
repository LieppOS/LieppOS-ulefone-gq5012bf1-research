+static int set_custom_ldo(struct adaptor_ctx *ctx, void *data, int val)
+{
+	unsigned long long ret, idx;
+
+	idx = (unsigned long long)data;
+
+	adaptor_logd(ctx, "E! idx(%llu),val(%d)\n", idx, val);
+
+	ret = custom_ldo_vout(ctx->custom_ldo_ch[idx], val);
+	adaptor_logd(ctx,
+		"custom_ldo_set_voltage(%s) ,num(%d) ,val(%d),ret(%llu)\n",
+		custom_ldo_names[idx], ctx->custom_ldo_ch[idx], val, ret);
+
+	custom_ldo_en(ctx->custom_ldo_ch[idx], 1);
+
+	return 0;
+}
+
+static int unset_custom_ldo(struct adaptor_ctx *ctx, void *data, int val)
+{
