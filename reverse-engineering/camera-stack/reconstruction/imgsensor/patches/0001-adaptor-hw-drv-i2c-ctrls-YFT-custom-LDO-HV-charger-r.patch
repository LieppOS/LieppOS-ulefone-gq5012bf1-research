+/* GQ5012BF1 (YFT): night-vision IR LED follows camera idx 4 (OV64B) */
+extern int flashlight_drvctrl(int cmd);	/* flashlight.ko */
+static bool nightled_is_open;
+
+static void yft_ctrl_nightled_by_idx(struct adaptor_ctx *ctx, int state)
+{
+	if (ctx->idx == 4) {
+		printk("lanny! %s, ctx->idx=%d, name:%s, state:%d\n",
+			__func__, ctx->idx, ctx->subdrv->name, state);
+		if (state && nightled_is_open != state) {
+			flashlight_drvctrl(1);
+			flashlight_drvctrl(11);
+			nightled_is_open = state;
+		} else if (!state && nightled_is_open) {
+			flashlight_drvctrl(0);
+			flashlight_drvctrl(10);
+			nightled_is_open = state;
+		}
+	}
+}
