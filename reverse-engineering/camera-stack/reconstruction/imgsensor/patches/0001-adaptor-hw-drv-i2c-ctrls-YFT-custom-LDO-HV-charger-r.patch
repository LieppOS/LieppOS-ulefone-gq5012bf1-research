+/* GQ5012BF1 (YFT): suspend high-voltage charging while a camera is open */
+static void imgsensor_high_voltage_supply(int enable_hv)
+{
+	static struct power_supply *chg_psy;
+	union power_supply_propval propval = {0};
+
+	if (chg_psy == NULL) {
+		chg_psy = power_supply_get_by_name("mtk-master-charger");
+		if (IS_ERR_OR_NULL(chg_psy)) {
+			printk("%s: fail to get usb_psy\n", __func__);
+			return;
+		}
+	}
+
+	if (IS_ERR(chg_psy)) {
+		printk("%s: Couldn't get chg_psy\n", __func__);
+	} else {
+		propval.intval = enable_hv;
+		power_supply_set_property(chg_psy,
+			POWER_SUPPLY_PROP_VOLTAGE_MAX, &propval);
+		printk("%s: enable_hv:%d\n", __func__, propval.intval);
+		power_supply_changed(chg_psy);
+	}
+
+	yft_cam_open_flag = !enable_hv;
+	printk("%s: yft_cam_open_flag:%d\n", __func__, yft_cam_open_flag);
+}
