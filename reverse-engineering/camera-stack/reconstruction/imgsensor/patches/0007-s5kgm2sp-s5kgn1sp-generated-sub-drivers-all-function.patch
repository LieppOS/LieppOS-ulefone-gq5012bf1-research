+				subdrv_i2c_rd_u8(ctx, addr_l);
+			DRV_LOG_MUST(ctx, "xqadd0 s5kgn1sp i2c_write_id(0x%x) sensor_id(0x%x/0x%x)\n",
+				ctx->i2c_write_id, *sensor_id, ctx->s_ctx.sensor_id);
+			DRV_LOG_MUST(ctx, "error: #######  cb s5kgn1sp i2c_write_id(0x%x) sensor_id(0x%x/0x%x)\n",
+				ctx->i2c_write_id, *sensor_id, ctx->s_ctx.sensor_id);
+			if (*sensor_id == S5KGN1SP_SENSOR_ID) {
+				*sensor_id = ctx->s_ctx.sensor_id;
+				return ERROR_NONE;
+			}
+			retry--;
+		} while (retry > 0);
+		i++;
+		retry = 2;
+	}
+	if (*sensor_id != ctx->s_ctx.sensor_id) {
+		*sensor_id = 0xFFFFFFFF;
+		return ERROR_SENSOR_CONNECT_FAIL;
+	}
+	DRV_LOG_MUST(ctx, "xqadd0 s5kgn1sp okss i2c_write_id(0x%x) sensor_id(0x%x/0x%x)\n",
+		ctx->i2c_write_id, *sensor_id, ctx->s_ctx.sensor_id);
+	DRV_LOG_MUST(ctx, "error: #######  cb s5kgn1sp  get_imgsensor_id out \n");
+	return ERROR_NONE;
+}
