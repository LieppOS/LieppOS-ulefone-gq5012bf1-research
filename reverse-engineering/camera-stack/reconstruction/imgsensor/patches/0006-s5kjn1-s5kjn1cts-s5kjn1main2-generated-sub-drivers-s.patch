+#include "s5kjn1ctsmipiraw_Sensor.h"
+
+static int get_imgsensor_id(struct subdrv_ctx *ctx, u32 *sensor_id);
+static int open(struct subdrv_ctx *ctx);
+static void set_group_hold(void *arg, u8 en);
+static u16 get_gain2reg(u32 gain);
+static int s5kjn1cts_set_test_pattern(struct subdrv_ctx *ctx, u8 *para, u32 *len);
+static int s5kjn1cts_set_test_pattern_data(struct subdrv_ctx *ctx, u8 *para, u32 *len);
+static int streaming_control_off(struct subdrv_ctx *ctx, u8 *para, u32 *len);
+static int streaming_control_on(struct subdrv_ctx *ctx, u8 *para, u32 *len);
+static int init_ctx(struct subdrv_ctx *ctx,	struct i2c_client *i2c_client, u8 i2c_write_id);
+static int vsync_notify(struct subdrv_ctx *ctx,	unsigned int sof_cnt);
+
+/* STOCK-PARITY data: regenerated byte-exact from the GQ5012BF1 stock module */
+#include "s5kjn1cts_stock_data.h"
+
+/* FUNCTION */
+
+/*
+ * Stock probes each i2c address twice per retry, swapping which of the two
+ * chip-ID registers is taken as the high byte, then applies the YFT
+ * CTS-board gate (CTS boards only).
+ */
+static int get_imgsensor_id(struct subdrv_ctx *ctx, u32 *sensor_id)
+{
+	u8 i = 0;
+	u8 retry = 2;
+	u32 addr_h = ctx->s_ctx.reg_addr_sensor_id.addr[0];
+	u32 addr_l = ctx->s_ctx.reg_addr_sensor_id.addr[1];
+
+	while (ctx->s_ctx.i2c_addr_table[i] != 0xFF) {
+		ctx->i2c_write_id = ctx->s_ctx.i2c_addr_table[i];
+		do {
+			*sensor_id = ((subdrv_i2c_rd_u8(ctx, addr_h) << 8) |
+				subdrv_i2c_rd_u8(ctx, addr_l)) - 1;
+			printk("xqadd0 s5kjn1cts i2c_write_id(0x%x) sensor_id(0x%x/0x%x)\n",
+				ctx->i2c_write_id, *sensor_id, ctx->s_ctx.sensor_id);
+			if (*sensor_id == S5KJN1CTS_SENSOR_ID && is_yft_cts_board() == 1) {
+				*sensor_id = ctx->s_ctx.sensor_id;
+				return ERROR_NONE;
+			}
+			*sensor_id = ((subdrv_i2c_rd_u8(ctx, addr_l) << 8) |
+				subdrv_i2c_rd_u8(ctx, addr_h)) - 1;
+			printk("xqadd0 s5kjn1cts i2c_write_id(0x%x) sensor_id(0x%x/0x%x)\n",
+				ctx->i2c_write_id, *sensor_id, ctx->s_ctx.sensor_id);
+			if (*sensor_id == S5KJN1CTS_SENSOR_ID && is_yft_cts_board() == 1) {
+				*sensor_id = ctx->s_ctx.sensor_id;
+				return ERROR_NONE;
+			}
+			retry--;
+		} while (retry > 0);
+		i++;
+		retry = 2;
+	}
+	if (*sensor_id != ctx->s_ctx.sensor_id || is_yft_cts_board() != 1) {
+		*sensor_id = 0xFFFFFFFF;
+		return ERROR_SENSOR_CONNECT_FAIL;
+	}
+	DRV_LOG_MUST(ctx, "xqadd0 s5kjn1cts okss i2c_write_id(0x%x) sensor_id(0x%x/0x%x)\n",
+		ctx->i2c_write_id, *sensor_id, ctx->s_ctx.sensor_id);
+	return ERROR_NONE;
+}
+
+static int init_ctx(struct subdrv_ctx *ctx,	struct i2c_client *i2c_client, u8 i2c_write_id)
+{
+	memcpy(&(ctx->s_ctx), &static_ctx, sizeof(struct subdrv_static_ctx));
+	subdrv_ctx_init(ctx);
+	ctx->i2c_client = i2c_client;
+	ctx->i2c_write_id = i2c_write_id;
+	return 0;
+}
+
+static void s5kjn1cts_sensor_init(struct subdrv_ctx *ctx)
+{
+	DRV_LOG(ctx, "E\n");
+	DRV_LOG(ctx, "Dphy-4lane setting\n");
+	subdrv_i2c_wr_u16(ctx, 0x6028, 0x4000);
+	subdrv_i2c_wr_u16(ctx, 0x0000, 0x0001);
+	subdrv_i2c_wr_u16(ctx, 0x0000, 0x38e1);
+	subdrv_i2c_wr_u16(ctx, 0x001e, 0x0007);
+	subdrv_i2c_wr_u16(ctx, 0x6028, 0x4000);
+	subdrv_i2c_wr_u16(ctx, 0x6010, 0x0001);
+	mdelay(5);
+	subdrv_i2c_wr_u16(ctx, 0x6226, 0x0001);
+	mdelay(10);
+	subdrv_i2c_wr_u16(ctx, 0x6028, 0x2400);
+	subdrv_i2c_wr_u16(ctx, 0x602a, 0x1354);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x0100);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x7017);
+	subdrv_i2c_wr_u16(ctx, 0x602a, 0x13b2);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x0000);
+	subdrv_i2c_wr_u16(ctx, 0x602a, 0x1236);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x0000);
+	subdrv_i2c_wr_u16(ctx, 0x602a, 0x1a0a);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x4c0a);
+	subdrv_i2c_wr_u16(ctx, 0x602a, 0x2210);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x3401);
+	subdrv_i2c_wr_u16(ctx, 0x602a, 0x2176);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x6400);
+	subdrv_i2c_wr_u16(ctx, 0x602a, 0x222e);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x0001);
+	subdrv_i2c_wr_u16(ctx, 0x602a, 0x06b6);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x0a00);
+	subdrv_i2c_wr_u16(ctx, 0x602a, 0x06bc);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x1001);
+	subdrv_i2c_wr_u16(ctx, 0x602a, 0x2140);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x0101);
+	subdrv_i2c_wr_u16(ctx, 0x602a, 0x1a0e);
+	subdrv_i2c_wr_u16(ctx, 0x6f12, 0x9600);
+	subdrv_i2c_wr_u16(ctx, 0x6028, 0x4000);
+	subdrv_i2c_wr_u16(ctx, 0xf44e, 0x0011);
+	subdrv_i2c_wr_u16(ctx, 0xf44c, 0x0b0b);
+	subdrv_i2c_wr_u16(ctx, 0xf44a, 0x0006);
+	subdrv_i2c_wr_u16(ctx, 0x0118, 0x0002);
+	subdrv_i2c_wr_u16(ctx, 0x011a, 0x0001);
+	DRV_LOG(ctx, "X\n");
+}
+
+static int open(struct subdrv_ctx *ctx)
+{
+	u32 sensor_id = 0;
+	u32 scenario_id = 0;
+
+	/* get sensor id */
+	if (get_imgsensor_id(ctx, &sensor_id) != ERROR_NONE)
+		return ERROR_SENSOR_CONNECT_FAIL;
+
+	/* initail setting */
+	s5kjn1cts_sensor_init(ctx);
+
+	memset(ctx->exposure, 0, sizeof(ctx->exposure));
+	memset(ctx->ana_gain, 0, sizeof(ctx->gain));
+	ctx->exposure[0] = ctx->s_ctx.exposure_def;
+	ctx->ana_gain[0] = ctx->s_ctx.ana_gain_def;
+	ctx->current_scenario_id = scenario_id;
+	ctx->pclk = ctx->s_ctx.mode[scenario_id].pclk;
+	ctx->line_length = ctx->s_ctx.mode[scenario_id].linelength;
+	ctx->frame_length = ctx->s_ctx.mode[scenario_id].framelength;
+	ctx->current_fps = ctx->pclk * 10 / ctx->line_length / ctx->frame_length;
+	ctx->readout_length = ctx->s_ctx.mode[scenario_id].readout_length;
+	ctx->read_margin = ctx->s_ctx.mode[scenario_id].read_margin;
+	ctx->min_frame_length = ctx->frame_length;
+	ctx->autoflicker_en = FALSE;
+	ctx->test_pattern = 0;
+	ctx->ihdr_mode = 0;
+	ctx->pdaf_mode = 0;
+	ctx->hdr_mode = 0;
+	ctx->extend_frame_length_en = 0;
+	ctx->is_seamless = 0;
+	ctx->fast_mode_on = 0;
+	ctx->sof_cnt = 0;
+	ctx->ref_sof_cnt = 0;
+	ctx->is_streaming = 0;
+
+	return ERROR_NONE;
+}
+
+static int vsync_notify(struct subdrv_ctx *ctx,	unsigned int sof_cnt)
+{
+	DRV_LOG(ctx, "sof_cnt(%u) ctx->ref_sof_cnt(%u) ctx->fast_mode_on(%d)",
+		sof_cnt, ctx->ref_sof_cnt, ctx->fast_mode_on);
+	if (ctx->fast_mode_on && (sof_cnt > ctx->ref_sof_cnt)) {
+		ctx->fast_mode_on = FALSE;
+		ctx->ref_sof_cnt = 0;
+		DRV_LOG(ctx, "seamless_switch disabled.");
+		set_i2c_buffer(ctx, ctx->s_ctx.reg_addr_fast_mode, 0x00);
+		commit_i2c_buffer(ctx);
+	}
+	return 0;
+}
+
+static u16 get_gain2reg(u32 gain)
+{
+	return gain * 32 / BASEGAIN;
+}
+
+static void set_group_hold(void *arg, u8 en)
+{
+	struct subdrv_ctx *ctx = (struct subdrv_ctx *)arg;
+
+	if (en)
+		set_i2c_buffer(ctx, 0x0104, 0x01);
+	else
+		set_i2c_buffer(ctx, 0x0104, 0x00);
+}
+
+static int s5kjn1cts_set_test_pattern(struct subdrv_ctx *ctx, u8 *para, u32 *len)
+{
+	u32 mode = *((u32 *)para);
+
+	if (mode != ctx->test_pattern)
+		DRV_LOG(ctx, "mode(%u->%u)\n", ctx->test_pattern, mode);
+	/* 1:Solid Color 2:Color Bar 5:Black */
+	if (mode)
+		subdrv_i2c_wr_u16(ctx, 0x0600, mode); /*100% Color bar*/
+	else if (ctx->test_pattern)
+		subdrv_i2c_wr_u16(ctx, 0x0600, 0x0000); /*No pattern*/
+
+	ctx->test_pattern = mode;
+	return ERROR_NONE;
+}
+
+static int s5kjn1cts_set_test_pattern_data(struct subdrv_ctx *ctx, u8 *para, u32 *len)
+{
+	struct mtk_test_pattern_data *data = (struct mtk_test_pattern_data *)para;
+	u16 R = (data->Channel_R >> 22) & 0x3ff;
+	u16 Gr = (data->Channel_Gr >> 22) & 0x3ff;
+	u16 Gb = (data->Channel_Gb >> 22) & 0x3ff;
+	u16 B = (data->Channel_B >> 22) & 0x3ff;
+
+	subdrv_i2c_wr_u16(ctx, 0x0602, R);
+	subdrv_i2c_wr_u16(ctx, 0x0604, Gr);
+	subdrv_i2c_wr_u16(ctx, 0x0606, B);
+	subdrv_i2c_wr_u16(ctx, 0x0608, Gb);
+
+	DRV_LOG(ctx, "mode(%u) R/Gr/Gb/B = 0x%04x/0x%04x/0x%04x/0x%04x\n",
+		ctx->test_pattern, R, Gr, Gb, B);
+	return ERROR_NONE;
+}
+
+static void custom_streaming_control(struct subdrv_ctx *ctx, bool enable)
+{
+	subdrv_i2c_wr_u8(ctx, 0x0100, enable);
+	mdelay(10);
+}
+
+static int streaming_control_off(struct subdrv_ctx *ctx, u8 *para, u32 *len)
+{
+	custom_streaming_control(ctx, FALSE);
+	return ERROR_NONE;
+}
+
+static int streaming_control_on(struct subdrv_ctx *ctx, u8 *para, u32 *len)
+{
+	custom_streaming_control(ctx, TRUE);
+	return ERROR_NONE;
+}
