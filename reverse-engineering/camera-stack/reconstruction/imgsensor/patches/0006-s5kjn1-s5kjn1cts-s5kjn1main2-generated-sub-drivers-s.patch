+/*
+ * Stock probes each i2c address twice per retry, swapping which of the two
+ * chip-ID registers is taken as the high byte, then applies the YFT
+ * CTS-board gate (non-CTS boards only).
+ */
+static int get_imgsensor_id(struct subdrv_ctx *ctx, u32 *sensor_id)
+{
+	u8 i = 0;
+	u8 retry = 2;
+	u32 addr_l = ctx->s_ctx.reg_addr_sensor_id.addr[1];
+	u32 addr_h = ctx->s_ctx.reg_addr_sensor_id.addr[0];
+
+	while (ctx->s_ctx.i2c_addr_table[i] != 0xFF) {
+		ctx->i2c_write_id = ctx->s_ctx.i2c_addr_table[i];
+		do {
+			*sensor_id = (subdrv_i2c_rd_u8(ctx, addr_h) << 8) |
+				(subdrv_i2c_rd_u8(ctx, addr_l) + 1);
+			printk("xqadd0 s5kjn1main2 i2c_write_id(0x%x) sensor_id(0x%x/0x%x)\n",
+				ctx->i2c_write_id, *sensor_id, ctx->s_ctx.sensor_id);
+			if (*sensor_id == S5KJN1MAIN2_SENSOR_ID && !is_yft_cts_board()) {
+				*sensor_id = ctx->s_ctx.sensor_id;
+				return ERROR_NONE;
+			}
+			*sensor_id = (subdrv_i2c_rd_u8(ctx, addr_l) << 8) |
+				(subdrv_i2c_rd_u8(ctx, addr_h) + 1);
+			printk("xqadd0 s5kjn1main2 i2c_write_id(0x%x) sensor_id(0x%x/0x%x)\n",
+				ctx->i2c_write_id, *sensor_id, ctx->s_ctx.sensor_id);
+			if (*sensor_id == S5KJN1MAIN2_SENSOR_ID && !is_yft_cts_board()) {
+				*sensor_id = ctx->s_ctx.sensor_id;
+				return ERROR_NONE;
+			}
+			retry--;
+		} while (retry > 0);
+		i++;
+		retry = 2;
+	}
+	if (*sensor_id != ctx->s_ctx.sensor_id || is_yft_cts_board()) {
+		*sensor_id = 0xFFFFFFFF;
+		return ERROR_SENSOR_CONNECT_FAIL;
+	}
+	printk("xqadd0 s5kjn1main2 okss i2c_write_id(0x%x) sensor_id(0x%x/0x%x)\n",
+		ctx->i2c_write_id, *sensor_id, ctx->s_ctx.sensor_id);
+	return ERROR_NONE;
+}
