+		if (ret < 0)
+			val = 0;
+		printk("%s: enabled=%d\n", __func__, val);
+		if (ret < 0)
+			continue;
+		if (val) {
+			*en = true;
+			return 0;
+		}
+		*en = false;
+	}
+	return ret;
+}
