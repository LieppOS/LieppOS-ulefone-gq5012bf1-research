+static int mt6375_tcp_notifier_call(struct notifier_block *nb,
+				    unsigned long event, void *data)
+{
+	struct tcp_notify *noti = data;
+	struct mt6375_chg_data *ddata = container_of(nb, struct mt6375_chg_data,
+						     pd_nb);
+
+	switch (event) {
+	case TCP_NOTIFY_PD_STATE:
+		switch (noti->pd_state.connected) {
+		case PD_CONNECT_NONE:
+			ddata->pd_status = false;
+			break;
+		case PD_CONNECT_PE_READY_SNK:
+		case PD_CONNECT_PE_READY_SNK_PD30:
+		case PD_CONNECT_PE_READY_SNK_APDO:
+			ddata->pd_status = true;
+			if (yft_usb_flag == 1) {
+				if (!queue_work(ddata->wq, &ddata->bc12_work))
+					mt_dbg(ddata->dev, "%s bc12 work already queued\n",
+					       __func__);
+			}
+			break;
+		case PD_CONNECT_HARD_RESET:
+			ddata->pd_status = false;
+			break;
+		default:
+			break;
+		}
+		printk("%s  event=%ld, pd state=%d, pd_status=%d\n", __func__,
+		       event, noti->pd_state.connected, ddata->pd_status);
+		break;
+	default:
+		break;
+	}
+	return NOTIFY_OK;
+}
