+static int mt6375_is_otg_enabled(struct charger_device *chgdev, bool *en)
+{
+	int i, ret = 0;
+	u32 val = 0;
+	struct mt6375_chg_data *ddata = charger_get_data(chgdev);
+
+	for (i = 0; i < 3; i++) {
