diff --git a/drivers/ufs/vendor/Kbuild b/drivers/ufs/vendor/Kbuild
new file mode 100644
index 0000000..41eae2c
--- /dev/null
+++ b/drivers/ufs/vendor/Kbuild
@@ -0,0 +1,17 @@
+# LieppOS storage build scope. DEVCIE_MODULES_INCLUDE (vendor spelling) is what the vendor
+# top-level Kbuild prepends to LINUXINCLUDE; it is restated here because each directory is a
+# separate Kbuild invocation. The unchanged vendor Makefile supplies flags and composition.
+LINUXINCLUDE := $(DEVCIE_MODULES_INCLUDE) $(LINUXINCLUDE)
+include $(src)/Makefile
+obj-y :=
+# GQ5012BF1 composition: the shipped ufs-mediatek-mod.ko contains no UFS-feature objects
+# (ufsfeature/ufshid/ufsshpb/ufstw/ufsringbuf) although the shared vendor defconfig enables
+# CONFIG_UFSFEATURE/CONFIG_UFSHID. Both vendor variants are built, as the vendor Makefile
+# does: ufs-mediatek-mod (ise-dummy; shipped) and ufs-mediatek-mod-ise (not shipped on this
+# board). The companion is required for build parity only: it is the module the stock
+# rpmb-mtk.ko records in depends= (ufs-mediatek-mod-ise,rpmb) for ufs_mtk_rpmb_get_raw_dev.
+obj-m := ufs-mediatek-mod.o ufs-mediatek-mod-ise.o
+ufs-mediatek-mod-y := ../ufs-mediatek.o ../ufs-mediatek-sysfs.o ../ufs-mediatek-mimic.o \
+                      ../ufs-mediatek-btag.o ../ufs-mediatek-rpmb.o ../ufs-mediatek-ise-dummy.o
+ufs-mediatek-mod-ise-y := ../ufs-mediatek.o ../ufs-mediatek-sysfs.o ../ufs-mediatek-mimic.o \
+                          ../ufs-mediatek-btag.o ../ufs-mediatek-rpmb.o ../ufs-mediatek-ise.o
