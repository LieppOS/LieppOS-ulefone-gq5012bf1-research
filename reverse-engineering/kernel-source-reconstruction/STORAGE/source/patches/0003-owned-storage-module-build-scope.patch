diff --git a/drivers/char/rpmb/Kbuild b/drivers/char/rpmb/Kbuild
new file mode 100644
index 0000000..a69ae1f
--- /dev/null
+++ b/drivers/char/rpmb/Kbuild
@@ -0,0 +1,11 @@
+# LieppOS storage build scope. DEVCIE_MODULES_INCLUDE (vendor spelling) is what the vendor
+# top-level Kbuild prepends to LINUXINCLUDE; it is restated here because each directory is a
+# separate Kbuild invocation. The unchanged vendor Makefile supplies flags and composition.
+LINUXINCLUDE := $(DEVCIE_MODULES_INCLUDE) $(LINUXINCLUDE)
+include $(src)/Makefile
+obj-y :=
+obj-m := rpmb.o rpmb-mtk.o
+# GQ5012BF1 board configuration: the device uses TrustKernel, not Trustonic. The stock
+# rpmb-mtk.ko imports no MobiCore (mc_*) symbol, so it was built with
+# CONFIG_TRUSTONIC_TEE_SUPPORT unset, while the shared vendor defconfig sets it =m.
+CFLAGS_rpmb-mtk.o += -include $(src)/gq5012bf1-board-config.h
diff --git a/drivers/char/rpmb/gq5012bf1-board-config.h b/drivers/char/rpmb/gq5012bf1-board-config.h
new file mode 100644
index 0000000..ac8450b
--- /dev/null
+++ b/drivers/char/rpmb/gq5012bf1-board-config.h
@@ -0,0 +1,6 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* GQ5012BF1 board configuration for rpmb-mtk.o (force-included after kconfig.h).
+ * The board ships the TrustKernel TEE (tkcore) and no Trustonic MobiCore driver; the stock
+ * rpmb-mtk.ko imports no mc_* symbol. The shared vendor defconfig sets Trustonic =m. */
+#undef CONFIG_TRUSTONIC_TEE_SUPPORT
+#undef CONFIG_TRUSTONIC_TEE_SUPPORT_MODULE
