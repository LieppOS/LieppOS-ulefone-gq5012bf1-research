+static int yft_parse_dts(struct device_node *node, const char *name)
+{
+	int gpio_num;
+
+	printk("%s: YFT_OTG_yft_parse_dts \n", __func__);
+	if (node) {
+		gpio_num = of_get_named_gpio(node, name, 0);
+		if (gpio_num < 0) {
+			printk("%s: YFT_OTG_of_get_named_gpio fail. \n", __func__);
+			return -1;
+		}
+		printk("%s: YFT_OTG_of_get_named_gpio GPIO is %d.\n", __func__, gpio_num);
+
+		if (!gpio_to_desc(gpio_num)) {
+			printk("%s: YFT_OTG_gpio_desc is null.\n", __func__);
+			return -1;
+		}
+		printk("%s: YFT_OTG_gpio_desc is not null.\n", __func__);
+
+		if (gpio_is_valid(gpio_num))
+			printk("%s: YFT_OTG_gpio number %d is valid. \n", __func__, gpio_num);
+	} else {
+		printk("%s: YFT_OTG_get gpio num fail. \n", __func__);
+		return -1;
+	}
+
+	if (gpio_request(gpio_num, name)) {
+		printk("%s: YFT_OTG_gpio_request fail. \n", __func__);
+		return -1;
+	}
+
+	if (gpio_direction_output(gpio_num, 0)) {
+		printk("%s: YFT_OTG_gpio_direction_output failed. \n", __func__);
+		return -1;
+	}
+	gpio_set_value(gpio_num, 0);
+	printk("%s: YFT_OTG_gpio_get_value =%d. \n", __func__, gpio_get_value(gpio_num));
+
+	return gpio_num;
+}
+
+int get_otg_select_gpio(void)
+{
+	struct device_node *node;
+
+	printk("%s: YFT_OTG_enter. \n", __func__);
+	node = of_find_compatible_node(NULL, NULL, "mediatek,extcon-usb");
+	if (!node) {
+		printk("%s: YFT_OTG_cannot get the node: 'mediatek,usb3'.\n", __func__);
+		return -ENODEV;
+	}
+
+	yft_otg_select_gpio_num = yft_parse_dts(node, "otg_gpio_select");
+	if (yft_otg_select_gpio_num < 0) {
+		printk("%s: YFT_OTG_yft_parse_dts 1 fail. \n", __func__);
+		return -1;
+	}
+	printk("%s: YFT_OTG_end. \n", __func__);
+
+	return 0;
+}
