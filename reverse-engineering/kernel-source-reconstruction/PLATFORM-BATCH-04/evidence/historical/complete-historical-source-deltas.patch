+static int pe50_fb_notifier_callback(struct notifier_block *nb,
+				     unsigned long event, void *v)
+{
+	int *blank = (int *)v;
+
+	pr_info("%s-111\n", __func__);
+	if (event != MTK_DISP_EVENT_BLANK)
+		return 0;
+
+	pr_info("%s+\n", __func__);
+	if (*blank == MTK_DISP_BLANK_UNBLANK) {
+		pr_info("#@# %s(%d) SCREEN ON\n", __func__, __LINE__);
+		pinfo->data->lcd_on = true;
+	} else if (*blank == MTK_DISP_BLANK_POWERDOWN) {
+		pr_info("#@# %s(%d) SCREEN OFF\n", __func__, __LINE__);
+		pinfo->data->lcd_on = false;
+	}
+	pr_info("%s-\n", __func__);
+	return 0;
+}
