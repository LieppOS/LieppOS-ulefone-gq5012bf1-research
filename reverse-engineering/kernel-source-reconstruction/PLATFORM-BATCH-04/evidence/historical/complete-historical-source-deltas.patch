+static ssize_t yft_charging_current_store(struct device *dev,
+					  struct device_attribute *attr,
+					  const char *buf, size_t size)
+{
+	struct mtk_charger *pinfo = dev->driver_data;
+	signed int temp = 0;
+
+	if (kstrtoint(buf, 10, &temp) == 0) {
+		chr_err("%s: temp=0x%x\n", __func__, temp);
+		yft_long_charger_flag = temp;
+		switch (temp) {
+		case 0:
+			pinfo->chg_data[CHG1_SETTING].thermal_charging_current_limit = 0;
+			pinfo->fast_charging_indicator = 5;
+			break;
+		case 0x1234:
+			pinfo->chg_data[CHG1_SETTING].thermal_charging_current_limit = -1;
+			pinfo->fast_charging_indicator = 0x15;
+			break;
+		default:
+			chr_err("%s: format error! temp=%d\n", __func__, temp);
+			break;
+		}
+		_wake_up_charger(pinfo);
+	} else {
+		chr_err("%s: format error!\n", __func__);
+	}
+	return size;
+}
