+ * Inputs             : power          - Target power state
+ * Outputs            : -
+ * Returns            : -
+ * Description        : Polling PDCA power on/off ACK
+ ***********************************************************************************/
+void gpufreq_pdca_polling_ack(enum gpufreq_power_state power)
