Subject: [PATCH 09/10] io_cmd enum name DSI_GET_AOD_STATE (proven by genksyms
 CRC of disp_pq_notify_backlight_changed)

---
 drivers/gpu/drm/mediatek/mediatek_v2/mtk_disp_recovery.c | 2 +-
 drivers/gpu/drm/mediatek/mediatek_v2/mtk_drm_ddp_comp.h  | 2 +-
 drivers/gpu/drm/mediatek/mediatek_v2/mtk_dsi.c           | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/mediatek/mediatek_v2/mtk_disp_recovery.c b/drivers/gpu/drm/mediatek/mediatek_v2/mtk_disp_recovery.c
index 0d34cb5..779bd99 100644
--- a/drivers/gpu/drm/mediatek/mediatek_v2/mtk_disp_recovery.c
+++ b/drivers/gpu/drm/mediatek/mediatek_v2/mtk_disp_recovery.c
@@ -586,7 +586,7 @@ int mtk_drm_esd_testing_process(struct mtk_drm_esd_ctx *esd_ctx, bool need_lock)
 
 		output_comp = mtk_ddp_comp_request_output(mtk_crtc);
 		if (output_comp && output_comp->funcs && output_comp->funcs->io_cmd) {
-			mtk_ddp_comp_io_cmd(output_comp, NULL, DSI_GET_DOZE_STATE, &is_doze);
+			mtk_ddp_comp_io_cmd(output_comp, NULL, DSI_GET_AOD_STATE, &is_doze);
 			if (is_doze) {
 				DDPINFO("[ESD] is in aod doze mode, skip esd check!\n");
 				return 0;
diff --git a/drivers/gpu/drm/mediatek/mediatek_v2/mtk_drm_ddp_comp.h b/drivers/gpu/drm/mediatek/mediatek_v2/mtk_drm_ddp_comp.h
