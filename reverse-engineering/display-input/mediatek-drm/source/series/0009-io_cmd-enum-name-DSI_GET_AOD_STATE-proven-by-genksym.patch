+++ b/drivers/gpu/drm/mediatek/mediatek_v2/mtk_dsi.c
@@ -11611,7 +11611,7 @@ static int mtk_dsi_io_cmd(struct mtk_ddp_comp *comp, struct cmdq_pkt *handle,
 		*dur_vblank = 1000000000UL / fps / vtotal * vfp / 1000;
 	}
 		break;
-	case DSI_GET_DOZE_STATE:
+	case DSI_GET_AOD_STATE:
