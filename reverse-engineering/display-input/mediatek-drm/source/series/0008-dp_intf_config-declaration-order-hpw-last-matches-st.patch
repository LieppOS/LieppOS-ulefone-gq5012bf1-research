From 55d48cdf6a18cc926331a33c4c5a5a681667c35d Mon Sep 17 00:00:00 2001
From: lieppos <l@l>
Date: Sun, 4 Oct 2026 21:18:31 +0300
Subject: [PATCH 08/10] dp_intf_config: declaration order (hpw last) matches
 stock register allocation

---
 drivers/gpu/drm/mediatek/mediatek_v2/mtk_dp_intf.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/mediatek/mediatek_v2/mtk_dp_intf.c b/drivers/gpu/drm/mediatek/mediatek_v2/mtk_dp_intf.c
index a10114b..10e6a80 100644
--- a/drivers/gpu/drm/mediatek/mediatek_v2/mtk_dp_intf.c
+++ b/drivers/gpu/drm/mediatek/mediatek_v2/mtk_dp_intf.c
@@ -832,10 +832,10 @@ static void mtk_dp_intf_config(struct mtk_ddp_comp *comp,
 	struct mtk_dp_intf *dp_intf = comp_to_dp_intf(comp);
 	struct mtk_drm_private *priv = comp->mtk_crtc->base.dev->dev_private;
 	unsigned int hsize = 0, vsize = 0;
-	unsigned int hpw = 0;
 	unsigned int hfp = 0, hbp = 0;
 	unsigned int vpw = 0;
 	unsigned int vfp = 0, vbp = 0;
+	unsigned int hpw = 0;
 	unsigned int bg_left = 0, bg_right = 0;
 	unsigned int bg_top = 0, bg_bot = 0;
 	unsigned int rw_times = 0;
