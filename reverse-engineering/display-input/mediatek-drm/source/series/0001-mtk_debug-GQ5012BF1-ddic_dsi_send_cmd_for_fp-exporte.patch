From 685c5c4ccaa1a179630341dbb42d7db50c22831b Mon Sep 17 00:00:00 2001
From: lieppos <l@l>
Date: Sun, 4 Oct 2026 20:02:06 +0300
Subject: [PATCH 01/10] mtk_debug: GQ5012BF1 ddic_dsi_send_cmd_for_fp
 (exported, used by VTDR6115 fingerprint HBM)

---
 .../gpu/drm/mediatek/mediatek_v2/mtk_debug.c  | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/drivers/gpu/drm/mediatek/mediatek_v2/mtk_debug.c b/drivers/gpu/drm/mediatek/mediatek_v2/mtk_debug.c
index b4617c5..9a559fe 100644
--- a/drivers/gpu/drm/mediatek/mediatek_v2/mtk_debug.c
+++ b/drivers/gpu/drm/mediatek/mediatek_v2/mtk_debug.c
@@ -1532,6 +1532,54 @@ int mtk_ddic_dsi_read_cmd(struct mtk_ddic_dsi_msg *cmd_msg)
 	return ret;
 }
 
+void ddic_dsi_send_cmd_for_fp(u8 *tx_buf, unsigned int cmd_num)
+{
+	int ret;
+	struct mtk_ddic_dsi_msg *cmd_msg =
+		vmalloc(sizeof(struct mtk_ddic_dsi_msg));
+
+	if (!cmd_msg) {
+		DDPPR_ERR("%s alloc cmd_msg fail\n", __func__);
+		return;
+	}
+
+	if (!cmd_num) {
+		DDPPR_ERR("%s invalid cmd_num\n", __func__);
+		vfree(cmd_msg);
+		return;
+	}
+	memset(cmd_msg, 0, sizeof(struct mtk_ddic_dsi_msg));
+
+	switch (cmd_num) {
+	case 1:
+		cmd_msg->type[0] = 0x05;
+		break;
+	case 2:
+		cmd_msg->type[0] = 0x15;
+		break;
+	default:
+		cmd_msg->type[0] = 0x39;
+		break;
+	}
+
+	cmd_msg->channel = 0;
+	cmd_msg->flags |= MIPI_DSI_MSG_USE_LPM;
+	cmd_msg->tx_cmd_num = 1;
+	cmd_msg->tx_buf[0] = tx_buf;
+	cmd_msg->tx_len[0] = cmd_num;
+
+	ret = mtk_ddic_dsi_send_cmd(cmd_msg, true);
+	if (ret != 0) {
+		DDPPR_ERR("mtk_ddic_dsi_send_cmd error\n");
+		goto done;
+	}
+done:
+	vfree(cmd_msg);
+
+	DDPMSG("%s end -\n", __func__);
+}
+EXPORT_SYMBOL(ddic_dsi_send_cmd_for_fp);
+
 void ddic_dsi_send_cmd_test(unsigned int case_num)
 {
 	unsigned int i = 0, j = 0;
