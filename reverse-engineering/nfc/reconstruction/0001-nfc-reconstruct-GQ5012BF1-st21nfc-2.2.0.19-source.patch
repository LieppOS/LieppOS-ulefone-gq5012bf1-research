+/*
+ * Validate NFCC communication by forcing it out of Quick Boot and waiting
+ * for an NCI CORE_RESET_NTF.
+ *
+ * Behavioral reconstruction from the stock GQ5012BF1 ST21 2.2.0.19 module.
+ */
+static int st21nfc_ping(struct st21nfc_device *st21nfc_dev)
+{
+	int status = -ENODEV;
+	int read_ret;
+	int retry;
+
+	if (st21nfc_dev->device_open) {
+		status = -EBUSY;
+		pr_err("%s : device already opened ret= %d\n",
+			__func__, status);
+		return status;
+	}
+
+	/*
+	 * Stock performs a one-byte read before forcing the NFCC out of
+	 * Quick Boot. The result is intentionally ignored.
+	 */
+	i2c_master_recv(st21nfc_dev->client, st21nfc_dev->buffer, 1);
+
+	gpiod_set_value(st21nfc_dev->gpiod_reset, 0);
+	msleep(20);
+
+	gpiod_set_value(st21nfc_dev->gpiod_reset, 1);
+	usleep_range(10000, 11000);
+
+	gpiod_set_value(st21nfc_dev->gpiod_reset, 0);
+	msleep(20);
+
+	gpiod_set_value(st21nfc_dev->gpiod_reset, 1);
+
+	pr_info("%s done Double Pulse Request\n", __func__);
+	msleep(10);
+
+	for (retry = 0; retry < 4; retry++) {
+
+		if (!gpiod_get_value(st21nfc_dev->gpiod_irq))
+			break;
+
+		read_ret = i2c_master_recv(st21nfc_dev->client,
+					   st21nfc_dev->buffer, 3);
+		if (read_ret != 3) {
+			pr_warn("%s Could not read header: %d\n",
+				__func__, read_ret);
+			continue;
+		}
+
+		if (st21nfc_dev->buffer[0] == 0x7e) {
+			if (st21nfc_dev->buffer[1] == 0x7e) {
+				if (st21nfc_dev->buffer[2] == 0x7e) {
+					pr_warn("%s Read 7E7E7E... header, IRQ always high ? Stop\n",
+						__func__);
+					return status;
+				}
+
+				st21nfc_dev->buffer[0] =
+					st21nfc_dev->buffer[2];
+
+				read_ret = i2c_master_recv(
+					st21nfc_dev->client,
+					&st21nfc_dev->buffer[1], 2);
+
+				if (read_ret != 2) {
+					pr_warn("%s Could not read rest of header after 7E7E: %d\n",
+						__func__, read_ret);
+					return status;
+				}
+			} else {
+				st21nfc_dev->buffer[0] =
+					st21nfc_dev->buffer[1];
+				st21nfc_dev->buffer[1] =
+					st21nfc_dev->buffer[2];
+
+				read_ret = i2c_master_recv(
+					st21nfc_dev->client,
+					&st21nfc_dev->buffer[2], 1);
+
+				if (read_ret != 1) {
+					pr_warn("%s Could not read payload length: %d\n",
+						__func__, read_ret);
+					return status;
+				}
+			}
+		}
+
+		read_ret = i2c_master_recv(st21nfc_dev->client,
+					   &st21nfc_dev->buffer[3],
+					   st21nfc_dev->buffer[2]);
+
+		if (read_ret != st21nfc_dev->buffer[2]) {
+			pr_warn("%s Could not read payload: %d\n",
+				__func__, read_ret);
+			return status;
+		}
+
+		pr_info("%s Read message (%d bytes): %02x %02x %02x %02x ...\n",
+			__func__, read_ret + 3,
+			st21nfc_dev->buffer[0],
+			st21nfc_dev->buffer[1],
+			st21nfc_dev->buffer[2],
+			st21nfc_dev->buffer[3]);
+
+		/*
+		 * Once CORE_RESET_NTF has been observed, keep success even if
+		 * further messages are drained during the bounded loop.
+		 */
+		if (st21nfc_dev->buffer[0] == 0x60 &&
+		    st21nfc_dev->buffer[1] == 0x00)
+			status = 0;
+
+		msleep(5);
+	}
+
+	return status;
+}
