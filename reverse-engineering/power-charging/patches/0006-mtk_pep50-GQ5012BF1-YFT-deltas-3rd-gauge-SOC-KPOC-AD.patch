+/*
+ * GQ5012BF1 (YFT) additions, reconstructed from the stock mtk_pep50.ko:
+ *  - pca_master / pca_slave / pca_voltage: last master/slave dvchg IBUS
+ *    and VBUS sampled by pe50_dump_charging_info()
+ *  - fast_charging: 3 while the PE5.0 algo is running, else 0
+ *  - display notifier: tracks LCD on/off; while the screen is on
+ *    pe50_get_ita_lmt() caps ITA at 2500mA
+ * __LINE__ values printed below match stock (3788/3791), as does the
+ * [blithe] __LINE__ in pe50_stop() (1219).
+ */
+static ssize_t show_pca_master(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
