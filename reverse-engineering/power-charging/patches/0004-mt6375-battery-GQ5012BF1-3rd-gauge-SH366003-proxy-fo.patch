-		if (soc_type == 0)
-			gm->soc = (daemon_soc + 50) / 100;
+		power_supply_get_property(fg_psy, POWER_SUPPLY_PROP_CAPACITY, &pval);
+		gm->soc = pval.intval;
 
 		bm_debug(
 		"[K]FG_DAEMON_CMD_SET_KERNEL_SOC = %d %d, type:%d\n",
@@ -3554,6 +3556,8 @@ static void mtk_battery_daemon_handler(struct mtk_battery *gm, void *nl_data,
 			gm->ui_soc = 50;
 		else
 			gm->ui_soc = (daemon_ui_soc + 50) / 100;
+		power_supply_get_property(fg_psy, POWER_SUPPLY_PROP_CAPACITY, &pval);
+		gm->ui_soc = pval.intval;
 
 		/* when UISOC changes, check the diff time for smooth */
 		if (old_uisoc != gm->ui_soc) {
@@ -3683,7 +3687,8 @@ static void mtk_battery_daemon_handler(struct mtk_battery *gm, void *nl_data,
 	{
 		int rtc_ui_soc;
 
-		rtc_ui_soc = gauge_get_int_property(GAUGE_PROP_RTC_UI_SOC);
+		power_supply_get_property(fg_psy, POWER_SUPPLY_PROP_CAPACITY, &pval);
+		rtc_ui_soc = pval.intval;
 
 		ret_msg->fgd_data_len += sizeof(rtc_ui_soc);
 		memcpy(ret_msg->fgd_data, &rtc_ui_soc,
@@ -3697,7 +3702,8 @@ static void mtk_battery_daemon_handler(struct mtk_battery *gm, void *nl_data,
 	{
 		int rtc_ui_soc;
 
