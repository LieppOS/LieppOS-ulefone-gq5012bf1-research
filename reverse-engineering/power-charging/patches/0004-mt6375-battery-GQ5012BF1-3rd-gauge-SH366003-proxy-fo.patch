 		gauge_set_property(GAUGE_PROP_CON0_SOC, _soc);
 		bm_debug("[K]FG_DAEMON_CMD_SET_CON0_SOC = %d\n", _soc);
 	}
@@ -3725,7 +3732,8 @@ static void mtk_battery_daemon_handler(struct mtk_battery *gm, void *nl_data,
 	{
 		int _soc = 0;
 
-		_soc = gauge_get_int_property(GAUGE_PROP_CON0_SOC);
+		power_supply_get_property(fg_psy, POWER_SUPPLY_PROP_CAPACITY, &pval);
+		_soc = pval.intval;
 		ret_msg->fgd_data_len += sizeof(_soc);
 		memcpy(ret_msg->fgd_data, &_soc, sizeof(_soc));
 		bm_debug("[K]FG_DAEMON_CMD_GET_CON0_SOC = %d\n", _soc);
@@ -3938,8 +3946,8 @@ static void mtk_battery_daemon_handler(struct mtk_battery *gm, void *nl_data,
