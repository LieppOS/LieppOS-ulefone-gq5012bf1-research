 };
 
+static ssize_t show_BAT_TEMP(struct device *dev,
+			     struct device_attribute *attr, char *buf)
+{
+	int tbat = force_get_tbat_internal(get_mtk_battery());
+
+	bm_err("%s: %d\n", __func__, tbat);
+	return sprintf(buf, "%d\n", tbat);
+}
+static DEVICE_ATTR(BAT_TEMP, 0444, show_BAT_TEMP, NULL);
+
 int battery_get_property(enum battery_property bp,
 			    int *val)
 {
@@ -4380,9 +4347,10 @@ int battery_init(struct platform_device *pdev)
 	gm->bs_data.bat_batt_temp = force_get_tbat(gm, true);
 	mtk_power_misc_init(gm);
 
