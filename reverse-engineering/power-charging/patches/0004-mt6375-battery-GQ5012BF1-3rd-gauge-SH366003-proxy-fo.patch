+		power_supply_get_property(fg_psy, POWER_SUPPLY_PROP_CAPACITY, &pval);
+		rtc_ui_soc = pval.intval;
 
 		if (rtc_ui_soc < 0) {
 			bm_err("[K]FG_DAEMON_CMD_SET_RTC_UI_SOC error,rtc_ui_soc=%d\n",
@@ -3715,7 +3721,8 @@ static void mtk_battery_daemon_handler(struct mtk_battery *gm, void *nl_data,
 	{
 		int _soc = 0;
 
