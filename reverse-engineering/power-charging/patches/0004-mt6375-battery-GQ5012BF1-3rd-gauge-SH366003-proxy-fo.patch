+	mtk_battery_daemon_init(pdev);
 	b_recovery_mode = is_recovery_mode();
 	gm->is_probe_done = true;
+	ret = device_create_file(&pdev->dev, &dev_attr_BAT_TEMP);
 
 	if (ret == 0 && b_recovery_mode == 0)
 		bm_err("[%s]: daemon mode DONE\n", __func__);
diff --git a/drivers/power/supply/mtk_battery_daemon.c b/drivers/power/supply/mtk_battery_daemon.c
