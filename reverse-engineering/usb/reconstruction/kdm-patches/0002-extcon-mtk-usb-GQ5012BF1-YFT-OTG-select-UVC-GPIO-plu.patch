+			return;
+		}
 		mtk_usb_extcon_set_role(extcon, USB_ROLE_NONE);
 	} else {
-		mtk_usb_extcon_set_vbus(extcon, true);
+		gpio_set_value(yft_uvc_vbus_gpio_num, 1);
+		if (yft_uvc_switch_gpio_num > 0)
+			gpio_set_value(yft_uvc_switch_gpio_num, 1);
+		uvc_insert_status = true;
+		if (yft_usb_flag == 1) {
