+/*
+ * The stock YFT source was built in a larger vendor include context which
+ * advances Clang's __COUNTER__ by 194 before module_init/module_exit.  Keep
+ * the generated addressable-symbol names byte-identical without emitting
+ * code or data.
+ */
+#define YFT_COUNTER_1 __COUNTER__
+#define YFT_COUNTER_2 (YFT_COUNTER_1 + YFT_COUNTER_1)
+#define YFT_COUNTER_4 (YFT_COUNTER_2 + YFT_COUNTER_2)
+#define YFT_COUNTER_8 (YFT_COUNTER_4 + YFT_COUNTER_4)
+#define YFT_COUNTER_16 (YFT_COUNTER_8 + YFT_COUNTER_8)
+#define YFT_COUNTER_32 (YFT_COUNTER_16 + YFT_COUNTER_16)
+#define YFT_COUNTER_64 (YFT_COUNTER_32 + YFT_COUNTER_32)
+#define YFT_COUNTER_128 (YFT_COUNTER_64 + YFT_COUNTER_64)
+enum { yft_counter_pad = 0 *
+	(YFT_COUNTER_128 + YFT_COUNTER_64 + YFT_COUNTER_2) };
+#undef YFT_COUNTER_128
+#undef YFT_COUNTER_64
+#undef YFT_COUNTER_32
+#undef YFT_COUNTER_16
+#undef YFT_COUNTER_8
+#undef YFT_COUNTER_4
+#undef YFT_COUNTER_2
+#undef YFT_COUNTER_1
+
 #include "ready.h"
 #include "sensor_comm.h"
 #include "sensor_list.h"
