+void transceiver_stop_timer(void)
+{
+	pr_err("%s-IN\n", __func__);
+	pr_err("%s-OUT\n", __func__);
+}
+
+void transceiver_restart_timer(void)
+{
+	pr_err("%s-IN\n", __func__);
+	pr_err("%s-OUT\n", __func__);
+}
+
 static int transceiver_enable(struct hf_device *hf_dev,
 		int sensor_type, int en)
 {
@@ -901,6 +856,37 @@ static struct notifier_block transceiver_pm_notifier = {
 	.notifier_call = transceiver_pm_notifier_call,
 };
 
+static int transceiver_fb_notifier_callback(struct notifier_block *self,
+		unsigned long event, void *v)
+{
+	int *data = (int *)v;
+
+	pr_err("%s-111\n", __func__);
+	if (v) {
+		if (event == MTK_DISP_EVENT_BLANK) {
+			pr_err("%s+\n", __func__);
+			if (*data == MTK_DISP_BLANK_UNBLANK) {
+				pr_err("#@# %s(%d) SCREEN ON\n",
+					__func__, 978);
+				transceiver_restart_timer();
+			} else if (*data == MTK_DISP_BLANK_POWERDOWN) {
+				pr_err("#@# %s(%d) SCREEN OFF\n",
+					__func__, 981);
+				transceiver_stop_timer();
+			}
+			pr_err("%s-\n", __func__);
+		}
+	} else {
+		pr_err("%s Invalid data!\n", __func__);
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static struct notifier_block transceiver_fb_notifier = {
+	.notifier_call = transceiver_fb_notifier_callback,
+};
+
 static int transceiver_shm_cfg(struct share_mem_config *cfg,
 		void *private_data)
 {
