+			strlcpy(maghub_used, info->name,
+				sizeof(maghub_used));
+			yft_msensor_device_add(info, 0);
+			yft_set_msensor_device_used(maghub_used, 1);
+		}
+		break;
+	case SENSOR_TYPE_LIGHT:
+		if (strlen(alspshub_used) == 0) {
+			strlcpy(alspshub_used, info->name,
+				sizeof(alspshub_used));
+			yft_alspssensor_device_add(info, 0);
+			yft_set_alspssensor_device_used(alspshub_used, 1);
+		}
+		break;
+	case SENSOR_TYPE_PRESSURE:
+		if (strlen(barohub_used) == 0) {
+			strlcpy(barohub_used, info->name,
+				sizeof(barohub_used));
+			yft_barosensor_device_add(info, 0);
+			yft_set_barosensor_device_used(barohub_used, 1);
+		}
+		break;
+	case SENSOR_TYPE_SAR:
+		if (strlen(sarhub_used) == 0) {
+			strlcpy(sarhub_used, info->name,
+				sizeof(sarhub_used));
+			yft_sarsensor_device_add(info, 0);
+			yft_set_sarsensor_device_used(sarhub_used, 1);
+		}
+		break;
+	default:
+		break;
+	}
+
 err_out:
 	mutex_unlock(&client->core->manager_lock);
 	return ret;
