+		cpus_read_unlock();
+
+		if (picked_cpu >= 0)
+			list_add_tail(&task.entry, &ctl->tasks);
+
+		spin_unlock(&ctl->task_lock);
+
+		if (picked_cpu < 0) {
 			tee_task_current = ktime_to_us(ktime_get());
