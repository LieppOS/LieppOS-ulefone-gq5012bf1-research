diff --git a/drivers/tee/tkcore/armtz/tee_mem.c b/drivers/tee/tkcore/armtz/tee_mem.c
index db9aee1..c5b4c4d 100644
--- a/drivers/tee/tkcore/armtz/tee_mem.c
+++ b/drivers/tee/tkcore/armtz/tee_mem.c
@@ -272,21 +272,19 @@ void tee_shm_pool_reset(struct device *dev, struct shm_pool *pool)
 }
 
 /**
- * \brief Return the logical address for a buffer, if it's within
- * range of addresses managed by the shm pool
+ * \brief Return the logical address
  *
  * \param pool          Pointer on the pool
- * \param paddr         Physical address of buffer's starting
- * \param length        Length of buffer
+ * \param paddr         Physical address
  *
  * \return Virtual/logical address
  *
- * Return the associated virtual/logical address. The given buffer
- * should reside within the range of addresses managed by the shm pool.
+ * Return the associated virtual/logical address. The address should be inside
+ * the range of addresses managed by the shm pool.
  *
  */
-void *tee_shm_pool_p2v_range(struct device *dev, struct shm_pool *pool,
-	unsigned long paddr, size_t length)
+void *tee_shm_pool_p2v(struct device *dev, struct shm_pool *pool,
+		       unsigned long paddr)
 {
 	unsigned long offset;
 	void *p;
@@ -295,8 +293,7 @@ void *tee_shm_pool_p2v_range(struct device *dev, struct shm_pool *pool,
 		return NULL;
 
 	mutex_lock(&pool->lock);
-	if (!is_valid_paddr(pool, paddr) ||
-			(pool->paddr + pool->size - paddr < length)) {
+	if (!is_valid_paddr(pool, paddr)) {
 		mutex_unlock(&pool->lock);
 		pr_err("%s() paddr=0x%p not in the shm pool\n",
 			__func__,
@@ -312,24 +309,6 @@ void *tee_shm_pool_p2v_range(struct device *dev, struct shm_pool *pool,
 	return p;
 }
 
-/**
- * \brief Return the logical address
- *
- * \param pool          Pointer on the pool
- * \param paddr         Physical address
- *
- * \return Virtual/logical address
- *
- * Return the associated virtual/logical address. The address should be inside
- * the range of addresses managed by the shm pool.
- *
- */
-void *tee_shm_pool_p2v(struct device *dev, struct shm_pool *pool,
-		       unsigned long paddr)
-{
-	return tee_shm_pool_p2v_range(dev, pool, paddr, 1);
-}
-
 /**
  * \brief Return the physical address
  *
