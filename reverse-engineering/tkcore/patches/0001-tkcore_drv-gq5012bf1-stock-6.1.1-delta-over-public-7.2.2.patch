-	task->param = param;
-	task->last_param = last_param;
+	int cpu;
+
+	if (ctl->cpu_mask == 0)
+		return -1;
 
-	INIT_WORK(&task->work, do_run_tee_task);
+	for (cpu = 0; cpu < nr_cpus; cpu++) {
+		if (cpu_locked(ctl, cpu))
+			return cpu;
+	}
+
+	return -1;
 }
 
